<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Embedded via -sectcreate __TEXT __info_plist so the sandboxed variant
	     has a bundle identifier (required for sandbox container creation)
	     without needing an .app bundle. -->
	<key>CFBundleIdentifier</key>
	<string>com.example.SandboxVmnetRepro</string>
	<key>CFBundleName</key>
	<string>SandboxVmnetRepro</string>
	<key>CFBundleVersion</key>
	<string>1</string>
</dict>
</plist>
