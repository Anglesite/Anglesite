---
// One tag's articles on an EmDash site (#2133), rendered on request with the template's markup
// (`src/pages/tags/[tag]/index.astro`). `params.tag` is the template's tag slug, the one the
// article pages link to; every EmDash term whose label maps to it is listed here. A slug no
// published article carries is a 404, and that 404 is never cached, so it can't outlive the
// publish that gives the tag its first article.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { tagGroups, taggedArticles } from "../../../lib/article-sources.ts";
import { mergeCacheHints } from "../../../lib/article-listings.ts";
import { labelFor, permalinkFor } from "../../../lib/tags.ts";
import { articleCacheOptions } from "../../../lib/worker-cache.ts";

export const prerender = false;

const { groups, cacheHint: termsHint } = await tagGroups();
const group = groups.find((g) => g.slug === Astro.params.tag);
if (!group) {
  return new Response(null, { status: 404 });
}
const { entries, cacheHint: articlesHint } = await taggedArticles(group);
if (entries.length === 0) {
  return new Response(null, { status: 404 });
}
if (Astro.cache?.enabled) Astro.cache.set(articleCacheOptions(mergeCacheHints([termsHint, articlesHint])));
// The heading shows the verbatim tag text(s), never the slug, like the template's page.
const heading = group.labels.join(" / ");
---

<BaseLayout title={`Tagged “${heading}”`} description={`Posts tagged “${heading}”.`}>
  <h1>Tagged &ldquo;{heading}&rdquo;</h1>
  <p><a href="/tags/">All tags</a></p>
  <ul>
    {entries.map((entry) => (
      <li>
        <a href={permalinkFor(entry.collection, entry.id)}>{labelFor(entry)}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
