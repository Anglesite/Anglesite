---
// AstroWind pack (#1649): the original's stats band — four headline numbers on a row.
// Placeholder figures; the owner replaces them with real ones (or deletes the section).
---

<section class="aw-stats" aria-label="Business at a glance">
  <dl>
    <div>
      <dt>Years in business</dt>
      <dd>10+</dd>
    </div>
    <div>
      <dt>Happy customers</dt>
      <dd>500+</dd>
    </div>
    <div>
      <dt>Projects completed</dt>
      <dd>1,200</dd>
    </div>
    <div>
      <dt>Average rating</dt>
      <dd>4.9★</dd>
    </div>
  </dl>
</section>

<style>
  .aw-stats {
    padding-block: calc(var(--spacing-unit) * 12);
    border-block: 1px solid var(--aw-border);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: calc(var(--spacing-unit) * 8);
    text-align: center;
  }

  /* Number above its label — dd holds the figure, dt the caption. */
  div {
    display: flex;
    flex-direction: column-reverse;
    gap: calc(var(--spacing-unit) * 1);
  }

  dd {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  dt {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
</style>
