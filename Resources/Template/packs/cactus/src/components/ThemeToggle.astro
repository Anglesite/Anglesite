---
// Astro Cactus pack (#1650): the original's light/dark switch, rebuilt on the chassis's
// CSS-var pattern — it flips `data-theme` on <html>, which `global.css` reads alongside
// `prefers-color-scheme` (system setting by default; an explicit pick wins in both
// directions). The button ships `hidden` and the script reveals it, so a visitor without
// JS sees no dead control and simply gets their system scheme.
//
// The script is a plain (hoisted, bundled) Astro <script>, deliberately not `is:inline`:
// `scripts/csp.ts` emits `script-src 'self' 'wasm-unsafe-eval'` with no `'unsafe-inline'`,
// so an inline theme-restore script would be blocked outright on a deployed site. The
// cost is that it runs deferred, so a visitor who has *overridden* their system scheme
// sees one frame of the system scheme on load; visitors on the default (the vast
// majority) see no flash at all. Restoring the pre-paint version needs a CSP nonce/hash
// pipeline the template doesn't have.
---

<button id="cactus-theme-toggle" class="cactus-theme-toggle" type="button" aria-pressed="false" hidden>
  <svg class="cactus-toggle-icon cactus-toggle-icon--moon" viewBox="0 0 24 24" width="18" height="18"
    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" focusable="false">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="cactus-toggle-icon cactus-toggle-icon--sun" viewBox="0 0 24 24" width="18" height="18"
    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <span class="cactus-toggle-label">Dark theme</span>
</button>

<script>
  const STORAGE_KEY = "cactus:theme";
  const root = document.documentElement;

  // localStorage throws outright in some privacy configurations — a theme preference is
  // never worth breaking the page over, so every access degrades to "no stored choice".
  function storedChoice(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  const saved = storedChoice();
  if (saved === "light" || saved === "dark") root.dataset.theme = saved;

  const button = document.getElementById("cactus-theme-toggle");
  if (button) {
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    // No explicit pick yet = follow the system, so the button's pressed state always
    // reflects what the visitor is actually looking at.
    const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : systemDark.matches);
    const sync = () => button.setAttribute("aria-pressed", String(isDark()));

    sync();
    button.hidden = false;

    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Private browsing: the choice still applies, it just doesn't outlive the page.
      }
      sync();
    });

    // Someone flipping their OS appearance while the page is open, with no explicit pick.
    systemDark.addEventListener("change", sync);
  }
</script>

<style>
  .cactus-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--cactus-rule);
    border-radius: var(--radius-sm);
    background-color: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .cactus-theme-toggle:hover {
    color: var(--cactus-link);
    border-color: var(--cactus-link);
  }

  /* The button's accessible name; the icons are decorative. */
  .cactus-toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Show the scheme the click switches *to*: moon while light is active, sun while dark is. */
  .cactus-toggle-icon--sun {
    display: none;
  }

  .cactus-theme-toggle[aria-pressed="true"] .cactus-toggle-icon--moon {
    display: none;
  }

  .cactus-theme-toggle[aria-pressed="true"] .cactus-toggle-icon--sun {
    display: block;
  }
</style>
