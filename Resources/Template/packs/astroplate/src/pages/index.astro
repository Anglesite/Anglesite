---
// Astroplate pack (#1653) homepage: testimonials lead (member/donor quotes), then mission
// pillars, a news teaser, and a closing "get involved" CTA — with the chassis's
// HomepageWriter sentinels kept byte-for-byte (title/description below, and the hero's
// <h1>/<p>). The `<section class="hero">` open tag is also load-bearing: HeroImage/LogoAsset
// insert the site logo and generated hero image right after it.
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeTestimonials from "../components/HomeTestimonials.astro";
import HomeMission from "../components/HomeMission.astro";
import HomeNews from "../components/HomeNews.astro";
import HomeCallToAction from "../components/HomeCallToAction.astro";
// anglesite:imports — integration component imports are injected here on setup
---

<BaseLayout
  title="Welcome — Your New Anglesite Business Website"
  description="Your business website is ready to set up in Anglesite."
>
  <section class="hero">
    <h1>Welcome</h1>
    <p>This site is ready to customize in Anglesite. Open the app to edit your pages, add content, and publish when you're ready.</p>
    <p class="ap-hero-actions">
      <a class="ap-btn ap-btn-primary" href="/about/">About us</a>
      <a class="ap-btn" href="/blog/">Read the news</a>
    </p>
    <!-- anglesite:hero-cta -->
  </section>
  <HomeTestimonials />
  <HomeMission />
  <HomeNews />
  <HomeCallToAction />
</BaseLayout>
