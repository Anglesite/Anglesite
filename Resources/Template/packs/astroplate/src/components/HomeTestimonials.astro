---
// Astroplate pack (#1653): member/donor quote section — reframed from the original's
// Swiper carousel (dropped; no new runtime dependencies) as a static three-up grid.
// Placed directly after the hero, ahead of the mission pillars, for the testimonial-first
// rhythm called out in docs/theme-curation.md's Organization row (distinct from AstroWind's
// features-then-stats order). Placeholder copy is generic on purpose; the owner edits it in
// the app like any other page content.
---

<section class="ap-testimonials" aria-labelledby="testimonials-heading">
  <h2 id="testimonials-heading">What our community says</h2>
  <p>Hear from the members, volunteers, and supporters who make this work possible.</p>
  <ul class="ap-quote-grid">
    <li class="ap-quote-card">
      <span class="ap-quote-mark" aria-hidden="true">&ldquo;</span>
      <blockquote>Being part of this organization changed how I show up for my neighbors.</blockquote>
      <p class="ap-quote-attribution">
        <span class="ap-quote-name">A member</span>
        <span class="ap-quote-role">Since 2021</span>
      </p>
    </li>
    <li class="ap-quote-card">
      <span class="ap-quote-mark" aria-hidden="true">&ldquo;</span>
      <blockquote>I give every year because I can see exactly where the support goes.</blockquote>
      <p class="ap-quote-attribution">
        <span class="ap-quote-name">A donor</span>
        <span class="ap-quote-role">Monthly supporter</span>
      </p>
    </li>
    <li class="ap-quote-card">
      <span class="ap-quote-mark" aria-hidden="true">&ldquo;</span>
      <blockquote>The team made it easy to jump in and start helping right away.</blockquote>
      <p class="ap-quote-attribution">
        <span class="ap-quote-name">A volunteer</span>
        <span class="ap-quote-role">First-time helper</span>
      </p>
    </li>
  </ul>
</section>
