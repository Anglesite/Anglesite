---
// Astroplate pack (#1653): plain-surface site header with a persistent "Get involved"
// button — organizations lead with the ask, unlike AstroWind's link-only nav. The slot
// receives whatever BaseLayout places at the `<!-- anglesite:nav -->` anchor (e.g. the
// menu integration's injected <Nav />), so integration nav items land inside this header
// instead of floating above it.
import { readConfig } from "../../scripts/config";

const siteName = readConfig("SITE_NAME") ?? "Home";
---

<header class="ap-header">
  <div class="ap-header-inner">
    <a class="ap-brand" href="/">{siteName}</a>
    <nav aria-label="Site">
      <a href="/about/">About</a>
      <a href="/blog/">News</a>
      <a href="/search/">Search</a>
    </nav>
    <slot />
    <a class="ap-btn ap-btn-primary ap-header-cta" href="/about/">Get involved</a>
  </div>
</header>

<style>
  .ap-header {
    border-bottom: 1px solid var(--ap-border);
    background-color: var(--color-background);
  }

  .ap-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 4);
    max-width: 68rem;
    margin-inline: auto;
    padding: calc(var(--spacing-unit) * 3) calc(var(--spacing-unit) * 6);
  }

  .ap-brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 5);
    margin-inline-end: auto;
  }

  nav a {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .ap-header-cta {
    padding-block: calc(var(--spacing-unit) * 2);
    padding-inline: calc(var(--spacing-unit) * 5);
    font-size: 0.9375rem;
  }
</style>
