---
/**
 * Booking widget component — embeds Cal.com or Calendly scheduling.
 *
 * Generated by /anglesite:booking. The skill populates the props from
 * the owner's configuration and injects this component into the
 * appropriate page or layout.
 */
interface Props {
  provider?: 'cal' | 'calendly';
  username?: string;
  eventSlug?: string;
  style?: 'inline' | 'floating' | 'button';
  buttonText?: string;
  brandColor?: string;
}
const {
  provider,
  username,
  eventSlug,
  style,
  buttonText = "Book Now",
  brandColor = "#000000",
} = Astro.props;

const calLink = eventSlug ? `${username}/${eventSlug}` : username;
const colorHex = brandColor.replace(/^#/, "");
const calendlyUrl = eventSlug
  ? `https://calendly.com/${username}/${eventSlug}?primary_color=${colorHex}`
  : `https://calendly.com/${username}?primary_color=${colorHex}`;
---

{/*
  The Cal.com/Calendly loaders live in public/scripts/ and read their per-instance config from
  data-* attributes instead of Astro's `define:vars`. `define:vars` forces Astro to inline the
  script body verbatim into the page — with no `'unsafe-inline'`, nonce, or hash in the site's
  CSP script-src, an inline body like that is silently blocked by the browser. A same-origin
  `<script src="...">` satisfies `script-src 'self'` without weakening the policy.
*/}

{/* ── Cal.com ── */}

{provider === "cal" && style === "inline" && (
  <div id="booking-cal" data-cal-init="inline" data-cal-link={calLink} data-cal-color={colorHex}></div>
  <script is:inline src="/scripts/booking-cal.js"></script>
)}

{provider === "cal" && style === "floating" && (
  <div data-cal-init="floating" data-cal-link={calLink} data-cal-color={colorHex} data-cal-button-text={buttonText} hidden></div>
  <script is:inline src="/scripts/booking-cal.js"></script>
)}

{provider === "cal" && style === "button" && (
  <button class="booking-button" data-cal-init="button" data-cal-link={calLink} data-cal-color={colorHex}>{buttonText}</button>
  <script is:inline src="/scripts/booking-cal.js"></script>
)}

{/* ── Calendly ── */}

{provider === "calendly" && style === "inline" && (
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <div class="calendly-inline-widget" data-url={calendlyUrl} style="min-width:320px;height:700px;"></div>
  <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
)}

{provider === "calendly" && style === "floating" && (
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <div data-calendly-init="floating" data-calendly-url={calendlyUrl} data-button-text={buttonText} data-brand-color={`#${colorHex}`} hidden></div>
  <script is:inline src="/scripts/booking-calendly.js"></script>
  <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
)}

{provider === "calendly" && style === "button" && (
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <button class="booking-button" data-calendly-init="button" data-calendly-url={calendlyUrl}>{buttonText}</button>
  <script is:inline src="/scripts/booking-calendly.js"></script>
  <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
)}

<style>
  .booking-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #2563eb);
    color: #fff;
    border: none;
    border-radius: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }
  .booking-button:hover {
    opacity: 0.9;
  }
  .booking-button:focus-visible {
    outline: 2px solid var(--color-primary, #2563eb);
    outline-offset: 2px;
  }
</style>
