---
/**
 * Category-based cookie/privacy consent banner. Gates any
 * `<script type="text/plain" data-consent="<category>">` until the visitor
 * grants that category. Necessary functionality is never gated — it isn't
 * listed here.
 *
 * Generated by the consent integration. Only categories the owner enabled
 * are shown; a site with none enabled never renders this component (the
 * descriptor's injected condition skips it entirely).
 */
interface Props {
  analytics?: boolean;
  embeds?: boolean;
  ads?: boolean;
  defaultPolicy?: "geo" | "strict";
  version?: string;
}
const {
  analytics = false,
  embeds = false,
  ads = false,
  defaultPolicy = "strict",
  version = "1",
} = Astro.props;

const categories: { key: string; label: string }[] = [
  analytics ? { key: "analytics", label: "Analytics" } : undefined,
  embeds ? { key: "embeds", label: "Embeds (video, maps, social)" } : undefined,
  ads ? { key: "ads", label: "Ads" } : undefined,
].filter((c): c is { key: string; label: string } => c !== undefined);

const categoryKeys = categories.map((c) => c.key);
---

{/*
  The consent-banner loader lives in public/scripts/ and reads its config from data-* attributes
  on #consent-banner instead of Astro's `define:vars`. `define:vars` forces Astro to inline the
  script body verbatim into the page — with no `'unsafe-inline'`, nonce, or hash in the site's
  CSP script-src, an inline body like that is silently blocked by the browser. A same-origin
  `<script src="...">` satisfies `script-src 'self'` without weakening the policy.
*/}

{categories.length > 0 && (
  <div
    id="consent-banner"
    class="consent-banner"
    hidden
    data-consent-categories={categoryKeys.join(",")}
    data-consent-default-policy={defaultPolicy}
    data-consent-version={version}
  >
    <p class="consent-banner-text">
      This site uses cookies for {categories.map((c) => c.label.toLowerCase()).join(", ")}.
      Necessary cookies are always on.
    </p>
    <div class="consent-banner-actions">
      <button type="button" data-consent-action="reject">Reject all</button>
      <button type="button" data-consent-action="preferences">Preferences</button>
      <button type="button" data-consent-action="accept" class="consent-banner-accept">Accept all</button>
    </div>
  </div>

  <div id="consent-modal" class="consent-modal" hidden>
    <div class="consent-modal-content" role="dialog" aria-label="Cookie preferences">
      <h2>Cookie preferences</h2>
      <p>Necessary cookies (e.g. login sessions, form security) are always on.</p>
      {categories.map((c) => (
        <label class="consent-modal-row">
          <input type="checkbox" data-consent-category={c.key} />
          {c.label}
        </label>
      ))}
      <div class="consent-modal-actions">
        <button type="button" data-consent-action="save">Save preferences</button>
      </div>
    </div>
  </div>

  <script is:inline src="/scripts/consent-banner.js"></script>
)}

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing-unit, 1rem) * 0.75);
    padding: calc(var(--spacing-unit, 1rem) * 0.75) var(--spacing-unit, 1rem);
    background: var(--color-surface, #fff);
    border-top: 1px solid var(--color-text-muted, #999);
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  }
  .consent-banner-text {
    flex: 1 1 20rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text, #111);
  }
  .consent-banner-actions {
    display: flex;
    gap: calc(var(--spacing-unit, 1rem) * 0.5);
    flex-wrap: wrap;
  }
  .consent-banner-actions button {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm, 0.25rem);
    border: 1px solid var(--color-text-muted, #999);
    background: transparent;
    color: var(--color-text, #111);
    cursor: pointer;
    font: inherit;
  }
  .consent-banner-accept {
    background: var(--color-primary, #2563eb) !important;
    border-color: var(--color-primary, #2563eb) !important;
    color: #fff !important;
  }
  .consent-modal {
    position: fixed;
    inset: 0;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-unit, 1rem);
    background: rgba(0, 0, 0, 0.4);
  }
  .consent-modal-content {
    max-width: 28rem;
    width: 100%;
    padding: calc(var(--spacing-unit, 1rem) * 1.5);
    border-radius: var(--radius-lg, 0.5rem);
    background: var(--color-surface, #fff);
    color: var(--color-text, #111);
  }
  .consent-modal-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }
  .consent-modal-actions {
    margin-block-start: var(--spacing-unit, 1rem);
    display: flex;
    justify-content: flex-end;
  }
  .consent-modal-actions button {
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-sm, 0.25rem);
    border: none;
    background: var(--color-primary, #2563eb);
    color: #fff;
    cursor: pointer;
    font: inherit;
  }
  @media (prefers-reduced-motion: reduce) {
    .consent-banner, .consent-modal { transition: none; }
  }
</style>
