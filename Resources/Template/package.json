{
  "name": "anglesite-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npx tsx scripts/well-known.ts check && npx tsx scripts/csp.ts && npx tsx scripts/edge-artifacts.ts && npx tsx scripts/experiments-artifact.ts && npx tsx scripts/mcp-artifact.ts",
    "build": "astro check && astro build && npx tsx scripts/check-microformats.ts && npx tsx scripts/validate-html.ts",
    "postbuild": "npx pagefind --site dist && npx tsx scripts/well-known.ts verify",
    "preview": "astro preview",
    "check": "npx tsx scripts/pre-deploy-check.ts",
    "check:packs": "tsx scripts/check-pack.ts",
    "build:packs": "zsh scripts/build-packs.sh",
    "a11y": "npx tsx scripts/a11y-audit.ts",
    "embed": "tsx scripts/embed-snapshot.ts",
    "build:ci": "npm run build && npx tsx scripts/pre-deploy-check.ts --json --strict",
    "test": "tsx --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" && npm run test:astro",
    "pretest:worker": "npx tsx scripts/experiments-artifact.ts && npx tsx scripts/mcp-artifact.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:scripts": "npx tsx --test scripts/*.test.ts scripts/embeds/*.test.ts src/lib/*.test.ts",
    "test:astro": "vitest run --config vitest.astro.config.ts"
  },
  "dependencies": {
    "@astroanimate/core": "0.1.2",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.0",
    "@dwk/activitypub": "1.0.0-beta.5",
    "@dwk/indieauth": "1.0.0-beta.2",
    "@dwk/mcp": "1.0.0-beta.1",
    "@dwk/micropub": "1.0.0-beta.3",
    "@dwk/microsub": "1.0.0-beta.2",
    "@dwk/solid-oidc": "1.0.0-beta.2",
    "@dwk/solid-pod": "1.0.0-beta.3",
    "@dwk/webfinger": "1.0.0-beta.2",
    "@dwk/webmention": "1.0.0-beta.2",
    "@dwk/websub": "1.0.0-beta.1",
    "@tgwf/co2": "^0.19.0",
    "astro": "^7.2.9",
    "astro-seo-schema": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260831.1",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@types/node": "^26.4.0",
    "html-validate": "^11.11.0",
    "microformats-parser": "^2.0.4",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "schema-dts": "^1.1.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "@astroanimate/core": {
      "astro": "$astro"
    }
  }
}
